{
    "compilerOptions": {
      "target": "ES2022",
      "lib": ["ES2023", "DOM"],
      "module": "esnext",
      "moduleResolution": "bundler",
      "jsx": "react-jsx",
      "strict": true,
      "skipLibCheck": true,
      "verbatimModuleSyntax": true,
      "noEmit": true
    },
    "include": ["src"]
  }
  